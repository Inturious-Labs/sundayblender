{{- /*
  Lists only pages worth indexing: the homepage, published issues, and
  the standalone pages named below. Those pages use `build.list: false`
  (to stay off the homepage issue list), so they are fetched by path.
  Section lists, taxonomy pages, and anything with
  `sitemap: { disable: true }` are left out.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- $pages := slice site.Home }}
  {{- $pages = $pages | append (where (where site.RegularPages "Section" "posts") "Params.hidden" "!=" true) }}
  {{- range slice "/about" "/archive" "/author" }}
    {{- with site.GetPage . }}{{ $pages = $pages | append . }}{{ end }}
  {{- end }}
  {{- range $pages }}
  {{- if not .Sitemap.Disable }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
